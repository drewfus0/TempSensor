#include <Arduino.h>
#include <Wire.h>

TwoWire i2c = TwoWire();

void scanBus(TwoWire& wire, const char* busName) {
  Serial.printf("\nScanning %s...\n", busName);
  
  byte error, address;
  int nDevices = 0;

  for (address = 1; address < 127; address++) {
    wire.beginTransmission(address);
    error = wire.endTransmission();

    if (error == 0) {
      Serial.printf("  Found: 0x%02X", address);
      
      wire.beginTransmission(address);
      wire.write(0xD0);
      wire.endTransmission();
      
      wire.requestFrom(address, 1);
      if (wire.available()) {
        uint8_t id = wire.read();
        if (id == 0x60) Serial.println(" ← BME280!");
        else Serial.printf(" (ID: 0x%02X)\n", id);
      } else {
        Serial.println();
      }
      
      nDevices++;
    }
  }
  
  Serial.printf("  Total: %d device(s)\n", nDevices);
}

void setup() {
  Serial.begin(115200);
  delay(1500);
  
  Serial.println("\n=== SCANNING I2C BUS (D1 mini Pro) ===");
  Serial.println("Bus: D2/GPIO4 (SDA), D1/GPIO5 (SCL)");
  i2c.begin(4, 5);
  scanBus(i2c, "I2C Bus");
}

void loop() {
  delay(5000);
}
